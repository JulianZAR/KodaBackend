# PostgreSQL bootstrap account
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-this-postgres-password

# NutriGO application database
NUTRIGO_DB_NAME=nutrigo
NUTRIGO_DB_USER=nutrigo_app
NUTRIGO_DB_PASSWORD=change-this-nutrigo-password

# Keycloak database
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak_app
KEYCLOAK_DB_PASSWORD=change-this-keycloak-db-password

# Keycloak development administrator. Never use this value in a shared environment.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-keycloak-admin-password
